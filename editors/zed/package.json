{
    "name": "mucad",
    "displayName": "Microcad Language",
    "version": "0.0.1",
    "description": "Microcad Plugin for Zed",
    "engines": {
        "zed": "^0.45.0"
    },
    "contributes": {
        "grammars": [
            {
                "language": "markdown",
                "scopeName": "markdown.mucad.codeblock",
                "path": "./grammars/markdown-mucad.tmLanguage.json"
            },
            {
                "language": "mucad",
                "scopeName": "source.mucad",
                "path": "./grammars/mucad.tmLanguage.json"
            }
        ]
    }
}
