# Upload credentials for upload.sh.
# Copy this file to .env and fill in your values: cp env.example .env
# .env is ignored by git – never commit real credentials.
# Values are taken literally (no shell expansion). Surrounding quotes are optional and removed:
# UPLOAD_PASSWORD=p@ss$word, UPLOAD_PASSWORD="p@ss$word" and UPLOAD_PASSWORD='p@ss$word' are equivalent.

# Protocol: sftp (recommended), ftps (FTP over TLS) or ftp (unencrypted, not recommended)
UPLOAD_PROTOCOL=sftp

# Server and login, as given by your hosting provider
UPLOAD_HOST=example.com
# Optional; defaults to 22 for sftp and 21 for ftp/ftps
UPLOAD_PORT=
UPLOAD_USER=username
UPLOAD_PASSWORD=

# Directory on the server that the web server serves.
# Caution: files in this directory that are not part of the site are deleted on upload.
UPLOAD_REMOTE_DIR=/play.mucad.org/httpdocs
